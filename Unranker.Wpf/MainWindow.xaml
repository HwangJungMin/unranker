<Window x:Class="Unranker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unranker WPF" Height="450" Width="800">
    <Grid>
        <TabControl Margin="16">
            <TabItem Header="페이지 1">
                <Grid Background="LightCoral"/>
            </TabItem>

            <TabItem Header="페이지 2">
                <Grid Background="#FFF5F8FC" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="PLC 상태 모니터링 (샘플)"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
                        <Border Background="White" BorderBrush="#FFD4DCE8" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="통신 상태" Foreground="#FF5E6A7D"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="12" Height="12" Fill="#FF3CB371" VerticalAlignment="Center"/>
                                    <TextBlock Text="정상 연결" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#FFD4DCE8" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="동작 모드" Foreground="#FF5E6A7D"/>
                                <TextBlock Text="{Binding Mode}" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" Foreground="#FF1F6FEB"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#FFD4DCE8" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="알람 상태" Foreground="#FF5E6A7D"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="12" Height="12" Fill="#FFFFB347" VerticalAlignment="Center"/>
                                    <TextBlock Text="주의 1건" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="White" BorderBrush="#FFD4DCE8" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#FFF3F6FB" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="태그" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="현재값" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="단위" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="업데이트" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1" Text="TANK_LEVEL" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="73.2" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="%" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="10:23:54" Margin="0,6,0,6"/>

                                <TextBlock Grid.Row="2" Text="LINE_SPEED" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="18.5" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="m/min" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="10:23:52" Margin="0,6,0,6"/>

                                <TextBlock Grid.Row="3" Text="MOTOR_TEMP" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="64.0" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="°C" Margin="0,6,0,6"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="10:23:49" Margin="0,6,0,6"/>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="라인 상태" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                                <Border Background="#FFE8F5E9" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <TextBlock Text="1호기: RUN" Foreground="#FF2E7D32" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#FFFFF3E0" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <TextBlock Text="2호기: IDLE" Foreground="#FFEF6C00" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#FFFFEBEE" CornerRadius="6" Padding="10">
                                    <TextBlock Text="3호기: STOP" Foreground="#FFC62828" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="페이지 3">
                <Grid Background="LightGreen"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
