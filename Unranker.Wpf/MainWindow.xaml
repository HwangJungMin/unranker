<Window x:Class="Unranker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unranker WPF" Height="450" Width="800">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Unranker WPF (.NET 8)"
                       FontSize="28"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="신규 WPF 프로그램이 준비되었습니다."
                       Margin="0,12,0,0"
                       FontSize="16"
                       HorizontalAlignment="Center"/>
            <Button Content="확인"
                    Margin="0,24,0,0"
                    Padding="20,8"
                    HorizontalAlignment="Center"
                    Click="OnConfirmClick"/>
        </StackPanel>
    </Grid>
</Window>
